/* =========================================
   MGAIO Launcher Black Theme QSS
   File: src/data/themes/black.qss
   ========================================= */

/* QWidget - base background and font */
QWidget {
    background-color: #121212; /* dark background */
    color: #EEEEEE;           /* light text */
    font-family: "Segoe UI";
    font-size: 11pt;
}

/* QLineEdit - search bar */
QLineEdit {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #333333;
    color: #EEEEEE;
}

/* QComboBox - filter dropdown */
QComboBox {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 28px;
    color: #EEEEEE;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #333333;
}
QComboBox QAbstractItemView {
    background-color: #121212;
    border: 1px solid #333333;
    selection-background-color: #333333;
    color: #EEEEEE;
}

/* QPushButton - top bar buttons */
QPushButton {
    background-color: #2C2C2C;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 6px 12px;
    color: #EEEEEE;
}
QPushButton:hover {
    background-color: #3C3C3C;
}
QPushButton:pressed {
    background-color: #555555;
}

/* QLabel - headers */
QLabel {
    color: #EEEEEE;
}
QLabel#rp_label, QLabel#rec_label {
    font-weight: bold;
    font-size: 12pt;
}

/* QScrollArea */
QScrollArea {
    border: none;
    background-color: #121212;
}

/* GameCard example */
GameCard {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 10px;
}

/* Scrollbar style */
QScrollBar:vertical {
    border: 1px solid #333333;
    background: #1E1E1E;
    width: 12px;
    margin: 0px 0px 0px 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #777777;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Play button - yellow */
QPushButton#play_btn {
    background-color: #FFCC00;  /* yellow */
    color: #000000;              /* black text */
    border-radius: 8px;
    font-weight: bold;
}
QPushButton#play_btn:hover {
    background-color: #FFE066;  /* lighter yellow */
}
QPushButton#play_btn:pressed {
    background-color: #E6B800;  /* darker yellow */
}

/* How to Play button - dark gray */
QPushButton#howto_btn {
    background-color: #2C2C2C;
    color: #EEEEEE;
    border-radius: 6px;
}
QPushButton#howto_btn:hover {
    background-color: #3C3C3C;
}
QPushButton#howto_btn:pressed {
    background-color: #555555;
}

/* Favorite button - dark red */
QPushButton#favorite_btn {
    background-color: #AA4444;
    color: #EEEEEE;
    border-radius: 6px;
}
QPushButton#favorite_btn:hover {
    background-color: #CC5555;
}
QPushButton#favorite_btn:pressed {
    background-color: #880000;
}
